{
  "expo": {
    "name": "All Care Pros",
    "slug": "allcarepros",
    "version": "1.0.0",
    "scheme": "allcarepros",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.allcarepros.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.allcarepros.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4d8f16be-f89c-467c-8f6c-80940e84c706"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow All Care Pros to access your photo library to upload profile pictures, share job requirements (such as showing a broken pipe or a room that needs painting), and provide verification documents like trade licenses.",
          "cameraPermission": "Allow All Care Pros to access your camera to take profile photos, document job requirements, and capture verification documents for account approval."
        }
      ]

    ]
  }
}